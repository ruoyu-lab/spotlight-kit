{
  "name": "@spotlight-kit/core",
  "version": "0.1.0",
  "description": "Framework-agnostic product tour engine: step state machine, target waiting and completion detection. No DOM, no UI.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruoyu-lab/spotlight-kit.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "keywords": [
    "onboarding",
    "tour",
    "walkthrough",
    "spotlight",
    "framework-agnostic"
  ]
}
